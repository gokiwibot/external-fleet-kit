# external-fleet-kit — example credentials. Robot.com sends you the real file out of band.
REMI_API_URL=https://remi.kiwi
REMI_API_KEY=live_sk_000000000000000000000000000000000000000000000000
REMI_TRANSPORT=mqtt
MQTT_HOST=mqtt.example.invalid
MQTT_PORT=8883
MQTT_USERNAME=fleet_acme
# Delivered out of band: paste it here (MQTT runbook, step 4).
MQTT_PASSWORD=
# In HTTP mode, REMI_TRANSPORT=http and these three replace the MQTT block above:
# HTTP_TOKEN=change-me-to-the-32-plus-char-token-you-registered
# HTTP_PORT=4300
# HTTP_PUBLIC_URL=https://fleet.acme-robotics.com/v1
SANDBOX_LOCATION_ID=V1StGXR8Z5jdHi6BmyT2q
SANDBOX_CENTER_LAT=33.9701
SANDBOX_CENTER_LNG=-118.4148
SANDBOX_PICKUP_EXTERNAL_ID=efk-sandbox-pickup
SANDBOX_DROPOFF_EXTERNAL_ID=efk-sandbox-dropoff
WEB_PORT=4310
# Kit-only options. HTTP_PUSH only applies in http mode; EFK_SCENARIO is what --scenario sets.
HTTP_PUSH=false
LOG_LEVEL=info
EFK_SCENARIO=default
