{
    "name": "external-fleet-kit",
    "version": "0.0.0",
    "description": "Reference fleet manager and simulator for remi's External Fleets contract (efk)",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=9"
    },
    "bin": {
        "efk": "./bin/efk.mjs"
    },
    "scripts": {
        "efk": "tsx src/cli/index.ts",
        "start": "tsx src/cli/index.ts start",
        "check": "biome check .",
        "format": "biome check . --write",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"test/**/*.test.ts\"",
        "sync-samples": "tsx scripts/sync-samples.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.14.0",
        "@turf/turf": "^7.3.1",
        "hono": "4.11.3",
        "ink": "7.1.0",
        "mqtt": "5.14.1",
        "pino": "^10.2.0",
        "pino-pretty": "^13.1.3",
        "react": "19.2.7",
        "zod": "^4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.0",
        "@types/node": "^22.10.0",
        "@types/react": "19.2.7",
        "tsx": "^4.21.0",
        "typescript": "^5.9.0"
    }
}
